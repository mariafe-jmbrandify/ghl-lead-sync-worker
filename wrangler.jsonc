{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghl-lead-sync-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },

  // Leads and sync history live in D1. Run `npx wrangler d1 create ghl-leads`
  // and paste the returned database_id here before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghl-leads",
      "database_id": "18b24dea-6f9f-42a1-aae8-162ede22f36a",
      "migrations_dir": "migrations"
    }
  ],

  // KV holds short-lived data: webhook de-duplication keys and the cached
  // Google access token. Run `npx wrangler kv namespace create KV`.
  "kv_namespaces": [
    { "binding": "KV", "id": "d8307af2a30e415ab296f7f1ffe2f596" }
  ],

  // Push unsynced leads to Google Sheets every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Non-secret settings. Secrets (GHL_WEBHOOK_SECRET, ADMIN_TOKEN,
  // GOOGLE_SERVICE_ACCOUNT_JSON, optional GOOGLE_PLACES_API_KEY) are set
  // with `npx wrangler secret put`.
  "vars": {
    "SHEET_ID": "16aC1KOii8WRAx5iFQfpmbPUnGicNQusq2XftQolQZfI",
    "SHEET_TAB": "Leads",
    "SYNC_BATCH_SIZE": "100",
    // Most Google Places lookups per sync run; cache hits don't count.
    "PLACES_MAX_PER_RUN": "25"
  }
}
