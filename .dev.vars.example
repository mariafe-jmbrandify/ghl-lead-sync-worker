# Copy to .dev.vars for local development (never commit .dev.vars).
GHL_WEBHOOK_SECRET=change-me-long-random-string
ADMIN_TOKEN=change-me-admin-password
# Paste the whole service account JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
